@using System.ComponentModel.DataAnnotations
@using eImovina.Shared.Users
@inject ApiClient Api

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="@_model">
            <MudStack Spacing="3">
                <MudTextField T="string" Label="Korisničko ime" @bind-Value="_model.UserName" For="@(() => _model.UserName)" Immediate="true" Variant="Variant.Outlined" />
                <MudTextField T="string" Label="E-mail" @bind-Value="_model.Email" For="@(() => _model.Email)" Immediate="true" Variant="Variant.Outlined" />
                <MudTextField T="string" Label="Lozinka" @bind-Value="_model.Password" For="@(() => _model.Password)"
                              Immediate="true" Variant="Variant.Outlined" InputType="InputType.Password" />
                <MudSelect T="int" Label="Uloge" MultiSelection="true" @bind-Value="_roleSelectValue" @bind-SelectedValues="_selectedRoleIds"
                           MultiSelectionTextFunc="@GetRoleSelectionText" Variant="Variant.Outlined">
                    @foreach (var role in _roles)
                    {
                        <MudSelectItem T="int" Value="@role.Id">@role.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="int?" Label="Zaposlenik" @bind-Value="_model.EmployeeId" Variant="Variant.Outlined">
                    <MudSelectItem T="int?" Value="@((int?)null)">Nepovezano</MudSelectItem>
                    @foreach (var employee in _employees)
                    {
                        <MudSelectItem T="int?" Value="@((int?)employee.Id)">@employee.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudStack>
        </MudForm>
        @if (_errorMessage is not null)
        {
            <ErrorAlert Message="@_errorMessage" Class="mt-3" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Odustani</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_saving">Spremi</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private MudForm _form = null!;
    private readonly CreateUserFormModel _model = new();
    private List<LookupDto> _roles = new();
    private List<LookupDto> _employees = new();
    private IReadOnlyCollection<int> _selectedRoleIds = new HashSet<int>();
    private int _roleSelectValue;
    private string? _errorMessage;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        var rolesTask = Api.GetAsync<List<LookupDto>>("api/lookups/roles");
        var employeesTask = Api.GetAsync<List<LookupDto>>("api/lookups/employees?unlinkedOnly=true");
        await Task.WhenAll(rolesTask, employeesTask);

        if (rolesTask.Result.IsSuccess)
        {
            _roles = rolesTask.Result.Value!;
        }
        if (employeesTask.Result.IsSuccess)
        {
            _employees = employeesTask.Result.Value!;
        }
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        if (_selectedRoleIds.Count == 0)
        {
            _errorMessage = "Potrebno je odabrati barem jednu ulogu.";
            return;
        }

        _saving = true;
        _errorMessage = null;

        var result = await Api.PostAsync<CreateUserDto, UserDetailDto>(
            "api/users",
            new CreateUserDto(_model.UserName, _model.Email, _model.Password, _selectedRoleIds.ToList(), _model.EmployeeId));

        _saving = false;

        if (result.IsSuccess)
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            _errorMessage = result.Error!.Message;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private string GetRoleSelectionText(IReadOnlyList<string> selectedIds) =>
        string.Join(", ", _roles.Where(r => selectedIds.Contains(r.Id.ToString())).Select(r => r.Name));

    private sealed class CreateUserFormModel
    {
        [Required(ErrorMessage = "Korisničko ime je obavezno.")]
        [MaxLength(100)]
        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "E-mail je obavezan.")]
        [MaxLength(200)]
        [EmailAddress(ErrorMessage = "Neispravan format e-maila.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Lozinka je obavezna.")]
        [MinLength(6, ErrorMessage = "Lozinka mora imati najmanje 6 znakova.")]
        public string Password { get; set; } = string.Empty;

        public int? EmployeeId { get; set; }
    }
}

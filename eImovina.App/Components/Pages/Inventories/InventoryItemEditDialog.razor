@using System.ComponentModel.DataAnnotations
@using eImovina.Shared.Inventories
@using eImovina.Shared.Locations
@inject ApiClient Api

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">@EquipmentLabel</MudText>
        @if (_loading)
        {
            <LoadingPanel Message="Učitavanje…" />
        }
        else
        {
            <MudForm @ref="_form" Model="@_model">
                <MudStack Spacing="3">
                    <MudRadioGroup T="bool" @bind-Value="_isFound">
                        <MudRadio T="bool" Value="true" Color="Color.Success">Pronađeno</MudRadio>
                        <MudRadio T="bool" Value="false" Color="Color.Error">Nedostaje</MudRadio>
                    </MudRadioGroup>
                    @if (_isFound)
                    {
                        <MudSelect T="int?" Label="Lokacija pronalaska" @bind-Value="_foundLocationId" Variant="Variant.Outlined">
                            @foreach (var location in _locations)
                            {
                                <MudSelectItem T="int?" Value="@((int?)location.Id)">@location.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudCheckBox T="bool" @bind-Value="_isDamaged" Label="Oštećeno" Color="Color.Warning" />
                    }
                    <MudTextField T="string" Label="Napomena" @bind-Value="_model.Note" For="@(() => _model.Note)" Immediate="true" Variant="Variant.Outlined" Lines="2" />
                </MudStack>
            </MudForm>
        }
        @if (_errorMessage is not null)
        {
            <ErrorAlert Message="@_errorMessage" Class="mt-3" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Odustani</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_saving">Spremi</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired] public int InventoryId { get; set; }
    [Parameter, EditorRequired] public int ItemId { get; set; }
    [Parameter] public string EquipmentLabel { get; set; } = string.Empty;
    [Parameter] public bool? InitialIsFound { get; set; }
    [Parameter] public int? InitialFoundLocationId { get; set; }
    [Parameter] public bool? InitialIsDamaged { get; set; }
    [Parameter] public string? InitialNote { get; set; }

    private MudForm _form = null!;
    private readonly InventoryItemFormModel _model = new();
    private List<LocationListItemDto> _locations = new();
    private bool _isFound;
    private int? _foundLocationId;
    private bool _isDamaged;
    private bool _loading = true;
    private string? _errorMessage;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        // Not-yet-processed items (InitialIsFound is null) default to "Pronađeno" - the more common
        // case - but nothing is saved until the user explicitly submits.
        _isFound = InitialIsFound ?? true;
        _foundLocationId = InitialFoundLocationId;
        _isDamaged = InitialIsDamaged ?? false;
        _model.Note = InitialNote;

        var result = await Api.GetAsync<PagedResult<LocationListItemDto>>("api/locations?PageSize=100");
        if (result.IsSuccess)
        {
            _locations = result.Value!.Items.ToList();
        }

        _loading = false;
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        // Cross-field rule DataAnnotations can't express: location is required only when found.
        if (_isFound && _foundLocationId is null)
        {
            _errorMessage = "Potrebno je odabrati lokaciju na kojoj je oprema pronađena.";
            return;
        }

        _saving = true;
        _errorMessage = null;

        var result = await Api.PutAsync<UpdateInventoryItemDto, InventoryItemDto>(
            $"api/inventories/{InventoryId}/items/{ItemId}",
            new UpdateInventoryItemDto(_isFound, _isFound ? _foundLocationId : null, _isFound && _isDamaged, _model.Note));

        _saving = false;

        if (result.IsSuccess)
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            _errorMessage = result.Error!.Message;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private sealed class InventoryItemFormModel
    {
        [MaxLength(1000)]
        public string? Note { get; set; }
    }
}

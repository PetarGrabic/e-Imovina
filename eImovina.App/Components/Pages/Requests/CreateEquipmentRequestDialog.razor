@using System.ComponentModel.DataAnnotations
@using eImovina.Shared.EquipmentRequests
@using eImovina.Shared.Common
@inject ApiClient Api

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <LoadingPanel Message="Učitavanje…" />
        }
        else
        {
            <MudForm @ref="_form" Model="@_model">
                <MudStack Spacing="3">
                    <MudSelect T="int" Label="Kategorija" @bind-Value="_model.EquipmentCategoryId"
                               For="@(() => _model.EquipmentCategoryId)" Variant="Variant.Outlined">
                        @foreach (var category in _categories)
                        {
                            <MudSelectItem T="int" Value="@category.Id">@category.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField T="string" Label="Opis" @bind-Value="_model.Description" For="@(() => _model.Description)"
                                  Immediate="true" Variant="Variant.Outlined" Lines="3"
                                  HelperText="Npr. „treba mi nova stolica”, „pokvario se miš”." />
                </MudStack>
            </MudForm>
        }
        @if (_errorMessage is not null)
        {
            <ErrorAlert Message="@_errorMessage" Class="mt-3" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Odustani</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="@(_saving || _loading)">Pošalji</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private MudForm _form = null!;
    private readonly CreateRequestFormModel _model = new();
    private bool _loading = true;
    private List<LookupDto> _categories = new();
    private string? _errorMessage;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetAsync<List<LookupDto>>("api/lookups/equipmentcategories");
        if (result.IsSuccess)
        {
            _categories = result.Value!;
        }

        _loading = false;
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _saving = true;
        _errorMessage = null;

        var result = await Api.PostAsync<CreateEquipmentRequestDto, EquipmentRequestDetailDto>(
            "api/equipmentrequests/mine",
            new CreateEquipmentRequestDto(_model.EquipmentCategoryId, _model.Description!));

        _saving = false;

        if (result.IsSuccess)
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            _errorMessage = result.Error!.Message;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private sealed class CreateRequestFormModel
    {
        [Range(1, int.MaxValue, ErrorMessage = "Potrebno je odabrati kategoriju.")]
        public int EquipmentCategoryId { get; set; }

        [Required(ErrorMessage = "Opis je obavezan.")]
        [MaxLength(1000)]
        public string? Description { get; set; }
    }
}

@page "/equipment"
@attribute [Authorize(Policy = "InventoryManagement")]
@using Microsoft.AspNetCore.WebUtilities
@using eImovina.Shared.Equipment
@using eImovina.Shared.Locations
@inject ApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Oprema — e-Imovina</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Oprema</MudText>

@if (_loadError is not null)
{
    <ErrorAlert Message="@_loadError" OnRetry="@(() => _table.ReloadServerData())" Class="mb-3" />
}

<MudTable T="EquipmentListItemDto" @ref="_table" ServerData="ServerReloadAsync" Hover="true" Dense="true" RowsPerPage="25">
    <ToolBarContent>
        <MudTextField T="string" Label="Pretraga" Immediate="true" DebounceInterval="400"
                      @bind-Value="_searchText" OnDebounceIntervalElapsed="OnFilterChangedAsync"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true"
                      Class="mr-4" Style="max-width: 220px;" />
        <MudSelect T="int?" Label="Kategorija" Value="_categoryId" ValueChanged="OnCategoryFilterChangedAsync"
                   Class="mr-4" Style="max-width: 180px;">
            <MudSelectItem T="int?" Value="@((int?)null)">Sve kategorije</MudSelectItem>
            @foreach (var category in _categories)
            {
                <MudSelectItem T="int?" Value="@((int?)category.Id)">@category.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="int?" Label="Status" Value="_statusId" ValueChanged="OnStatusFilterChangedAsync"
                   Class="mr-4" Style="max-width: 160px;">
            <MudSelectItem T="int?" Value="@((int?)null)">Svi statusi</MudSelectItem>
            @foreach (var status in _statuses)
            {
                <MudSelectItem T="int?" Value="@((int?)status.Id)">@status.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="int?" Label="Lokacija" Value="_locationId" ValueChanged="OnLocationFilterChangedAsync"
                   Class="mr-4" Style="max-width: 200px;">
            <MudSelectItem T="int?" Value="@((int?)null)">Sve lokacije</MudSelectItem>
            @foreach (var location in _locations)
            {
                <MudSelectItem T="int?" Value="@((int?)location.Id)">@location.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="int?" Label="Zaposlenik" Value="_employeeId" ValueChanged="OnEmployeeFilterChangedAsync"
                   Class="mr-4" Style="max-width: 200px;">
            <MudSelectItem T="int?" Value="@((int?)null)">Svi zaposlenici</MudSelectItem>
            @foreach (var employee in _employees)
            {
                <MudSelectItem T="int?" Value="@((int?)employee.Id)">@employee.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="bool" Label="Status arhive" Value="_isArchived" ValueChanged="OnArchivedFilterChangedAsync"
                   Class="mr-4" Style="max-width: 160px;">
            <MudSelectItem T="bool" Value="false">Aktivna</MudSelectItem>
            <MudSelectItem T="bool" Value="true">Arhivirana</MudSelectItem>
        </MudSelect>
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.FilterAltOff" OnClick="ResetFiltersAsync">
            Poništi filtere
        </MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.QrCodeScanner" Href="/equipment/scan" Class="mr-2">
            Skeniraj QR kod
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/equipment/create">
            Nova oprema
        </MudButton>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Slika</MudTh>
        <MudTh><MudTableSortLabel T="EquipmentListItemDto" SortLabel="inventorynumber">Inventurni broj</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="EquipmentListItemDto" SortLabel="name">Naziv</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="EquipmentListItemDto" SortLabel="category">Kategorija</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="EquipmentListItemDto" SortLabel="status">Status</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="EquipmentListItemDto" SortLabel="location">Lokacija</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="EquipmentListItemDto" SortLabel="value">Vrijednost</MudTableSortLabel></MudTh>
        <MudTh>Akcije</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Slika">
            @if (context.CoverFileId is int coverId)
            {
                <MudImage Src="@($"/files/{coverId}")" Alt="@context.Name" ObjectFit="ObjectFit.Cover" Width="48" Height="48" Class="rounded" />
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Color="Color.Default" Title="Nema slike" />
            }
        </MudTd>
        <MudTd DataLabel="Inventurni broj">@context.InventoryNumber</MudTd>
        <MudTd DataLabel="Naziv">@context.Name</MudTd>
        <MudTd DataLabel="Kategorija">@context.CategoryName</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Color="@GetStatusColor(context.EquipmentStatusId)" Size="Size.Small">@context.StatusName</MudChip>
        </MudTd>
        <MudTd DataLabel="Lokacija">@context.LocationName</MudTd>
        <MudTd DataLabel="Vrijednost">@(context.PurchaseValue is decimal v ? $"{v:0.00} {context.Currency}" : "—")</MudTd>
        <MudTd DataLabel="Akcije">
            <MudTooltip Text="Detalji">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Href="@($"/equipment/{context.Id}")"
                               UserAttributes="@(new Dictionary<string, object> { ["aria-label"] = $"Detalji {context.Name}" })" />
            </MudTooltip>
            <MudTooltip Text="Uredi">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Href="@($"/equipment/{context.Id}/edit")"
                               UserAttributes="@(new Dictionary<string, object> { ["aria-label"] = $"Uredi {context.Name}" })" />
            </MudTooltip>
            @if (context.IsArchived)
            {
                <MudTooltip Text="Reaktiviraj">
                    <MudIconButton Icon="@Icons.Material.Filled.Unarchive" Size="Size.Small" Color="Color.Success" OnClick="@(() => ReactivateAsync(context))"
                                   UserAttributes="@(new Dictionary<string, object> { ["aria-label"] = $"Reaktiviraj {context.Name}" })" />
                </MudTooltip>
            }
            else
            {
                <MudTooltip Text="Arhiviraj">
                    <MudIconButton Icon="@Icons.Material.Filled.Archive" Size="Size.Small" Color="Color.Error" OnClick="@(() => ArchiveAsync(context))"
                                   UserAttributes="@(new Dictionary<string, object> { ["aria-label"] = $"Arhiviraj {context.Name}" })" />
                </MudTooltip>
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <EmptyState Message="Nema opreme za prikaz." />
    </NoRecordsContent>
    <LoadingContent>
        <LoadingPanel Message="Učitavanje opreme…" />
    </LoadingContent>
    <PagerContent>
        <MudTablePager RowsPerPageString="Redaka po stranici:" AllItemsText="Sve" InfoFormat="{first_item}-{last_item} od {all_items}" />
    </PagerContent>
</MudTable>

@code {
    private MudTable<EquipmentListItemDto> _table = null!;
    private List<LookupDto> _categories = new();
    private List<LookupDto> _statuses = new();
    private List<LocationListItemDto> _locations = new();
    private List<LookupDto> _employees = new();
    private string? _searchText;
    private int? _categoryId;
    private int? _statusId;
    private int? _locationId;
    private int? _employeeId;
    private bool _isArchived;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        var categoriesTask = Api.GetAsync<List<LookupDto>>("api/lookups/equipmentcategories");
        var statusesTask = Api.GetAsync<List<LookupDto>>("api/lookups/equipmentstatuses");
        var locationsTask = Api.GetAsync<PagedResult<LocationListItemDto>>("api/locations?PageSize=100");
        var employeesTask = Api.GetAsync<List<LookupDto>>("api/lookups/employees");
        await Task.WhenAll(categoriesTask, statusesTask, locationsTask, employeesTask);

        if (categoriesTask.Result.IsSuccess)
        {
            _categories = categoriesTask.Result.Value!;
        }
        if (statusesTask.Result.IsSuccess)
        {
            _statuses = statusesTask.Result.Value!;
        }
        if (locationsTask.Result.IsSuccess)
        {
            _locations = locationsTask.Result.Value!.Items.ToList();
        }
        if (employeesTask.Result.IsSuccess)
        {
            _employees = employeesTask.Result.Value!;
        }
    }

    private async Task<TableData<EquipmentListItemDto>> ServerReloadAsync(TableState state, CancellationToken ct)
    {
        var dir = state.SortDirection == MudBlazor.SortDirection.Descending
            ? eImovina.Shared.Common.SortDirection.Descending
            : eImovina.Shared.Common.SortDirection.Ascending;

        var queryParams = new Dictionary<string, string?>
        {
            ["Page"] = (state.Page + 1).ToString(),
            ["PageSize"] = state.PageSize.ToString(),
            ["Dir"] = dir.ToString(),
        };
        if (!string.IsNullOrWhiteSpace(state.SortLabel))
        {
            queryParams["Sort"] = state.SortLabel;
        }
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            queryParams["Text"] = _searchText;
        }
        if (_categoryId is int categoryId)
        {
            queryParams["CategoryId"] = categoryId.ToString();
        }
        if (_statusId is int statusId)
        {
            queryParams["StatusId"] = statusId.ToString();
        }
        if (_locationId is int locationId)
        {
            queryParams["LocationId"] = locationId.ToString();
        }
        if (_employeeId is int employeeId)
        {
            queryParams["EmployeeId"] = employeeId.ToString();
        }
        queryParams["IsArchived"] = _isArchived.ToString();

        var url = QueryHelpers.AddQueryString("api/equipment", queryParams);
        var result = await Api.GetAsync<PagedResult<EquipmentListItemDto>>(url, ct);

        if (!result.IsSuccess)
        {
            _loadError = result.Error!.Message;
            return new TableData<EquipmentListItemDto> { TotalItems = 0, Items = Array.Empty<EquipmentListItemDto>() };
        }

        _loadError = null;
        return new TableData<EquipmentListItemDto> { TotalItems = result.Value!.TotalCount, Items = result.Value.Items };
    }

    private Task OnFilterChangedAsync(string _) => _table.ReloadServerData();

    private Task OnCategoryFilterChangedAsync(int? value)
    {
        _categoryId = value;
        return _table.ReloadServerData();
    }

    private Task OnStatusFilterChangedAsync(int? value)
    {
        _statusId = value;
        return _table.ReloadServerData();
    }

    private Task OnLocationFilterChangedAsync(int? value)
    {
        _locationId = value;
        return _table.ReloadServerData();
    }

    private Task OnEmployeeFilterChangedAsync(int? value)
    {
        _employeeId = value;
        return _table.ReloadServerData();
    }

    private Task OnArchivedFilterChangedAsync(bool value)
    {
        _isArchived = value;
        return _table.ReloadServerData();
    }

    private async Task ResetFiltersAsync()
    {
        _searchText = null;
        _categoryId = null;
        _statusId = null;
        _locationId = null;
        _employeeId = null;
        _isArchived = false;
        await _table.ReloadServerData();
    }

    // EquipmentStatuses fixed seeded ids: 1 Na skladištu, 2 Zaduženo, 3 Na servisu, 4 Nedostaje,
    // 5 Otpisano. Color.Error reserved for genuinely concerning states (Nedostaje) only.
    private static Color GetStatusColor(int statusId) => statusId switch
    {
        1 => Color.Success,
        2 => Color.Info,
        3 => Color.Warning,
        4 => Color.Error,
        _ => Color.Default,
    };

    private async Task ArchiveAsync(EquipmentListItemDto row)
    {
        var confirmed = await DialogService.ConfirmAsync(
            "Arhivirati opremu?",
            $"Oprema „{row.Name}” ({row.InventoryNumber}) bit će arhivirana.",
            "Arhiviraj",
            Color.Error);
        if (!confirmed)
        {
            return;
        }

        var result = await Api.DeleteAsync($"api/equipment/{row.Id}");
        if (result.IsSuccess)
        {
            Snackbar.Add("Oprema je arhivirana.", Severity.Success);
            await _table.ReloadServerData();
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
    }

    private async Task ReactivateAsync(EquipmentListItemDto row)
    {
        var confirmed = await DialogService.ConfirmAsync(
            "Reaktivirati opremu?",
            $"Oprema „{row.Name}” ({row.InventoryNumber}) ponovno će biti aktivna.",
            "Reaktiviraj",
            Color.Success);
        if (!confirmed)
        {
            return;
        }

        var result = await Api.PostAsync<ReactivateEquipmentResultDto>($"api/equipment/{row.Id}/reactivate");
        if (result.IsSuccess)
        {
            Snackbar.Add("Oprema je reaktivirana.", Severity.Success);
            if (result.Value!.HasLiveInventoryAtLocation)
            {
                Snackbar.Add(
                    "Napomena: na ovoj lokaciji trenutačno je inventura u tijeku - ova oprema neće biti uključena dok se ne otvori sljedeća inventura.",
                    Severity.Info);
            }
            await _table.ReloadServerData();
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
    }
}

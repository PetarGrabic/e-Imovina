@page "/equipment/{Id:int}/edit"
@attribute [Authorize(Policy = "InventoryManagement")]
@using eImovina.Shared.Equipment
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>Uredi opremu — e-Imovina</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Uredi opremu</MudText>

@if (_loading)
{
    <LoadingPanel Message="Učitavanje opreme…" />
}
else if (_loadError is not null)
{
    <ErrorAlert Message="@_loadError" OnRetry="LoadAsync" />
}
else
{
    <EquipmentForm Existing="_equipment" OnSaved="@(id => Navigation.NavigateTo($"/equipment/{id}"))" />
}

@code {
    [Parameter] public int Id { get; set; }

    private bool _loading = true;
    private string? _loadError;
    private EquipmentDetailDto? _equipment;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;

        var result = await Api.GetAsync<EquipmentDetailDto>($"api/equipment/{Id}");
        _loading = false;

        if (result.IsSuccess)
        {
            _equipment = result.Value;
        }
        else
        {
            _loadError = result.Error!.Message;
        }
    }
}

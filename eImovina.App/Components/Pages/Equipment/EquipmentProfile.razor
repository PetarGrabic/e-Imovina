@page "/equipment/{Id:int}"
@attribute [Authorize(Policy = "InventoryManagement")]
@using eImovina.App.Components.Pages.Assignments
@using eImovina.Shared.Assignments
@using eImovina.Shared.Equipment
@inject ApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@(_equipment?.Name ?? "Oprema") — e-Imovina</PageTitle>

@if (_loading)
{
    <LoadingPanel Message="Učitavanje opreme…" />
}
else if (_loadError is not null)
{
    <ErrorAlert Message="@_loadError" OnRetry="LoadAsync" />
}
else if (_equipment is not null)
{
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h5">@_equipment.Name</MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" Href="@($"/equipment/{Id}/edit")">Uredi</MudButton>
            @if (_equipment.CurrentAssigneeName is null)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenAssignDialogAsync">Zaduži opremu</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AssignmentReturn" OnClick="ReturnAsync">Vrati opremu</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.SwapHoriz" OnClick="OpenTransferDialogAsync">Premjesti opremu</MudButton>
            }
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.LocationOn" OnClick="OpenChangeLocationDialogAsync">Promijeni lokaciju</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Archive" OnClick="ArchiveAsync">Arhiviraj</MudButton>
        </MudStack>
    </MudStack>

    <MudPaper Class="pa-4 mb-4">
        <MudGrid>
            <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.caption">Inventurni broj</MudText><MudText>@_equipment.InventoryNumber</MudText></MudItem>
            <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.caption">Serijski broj</MudText><MudText>@(_equipment.SerialNumber ?? "—")</MudText></MudItem>
            <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.caption">Status</MudText><MudText>@_equipment.StatusName</MudText></MudItem>
            <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.caption">Kategorija</MudText><MudText>@_equipment.CategoryName</MudText></MudItem>
            <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.caption">Lokacija</MudText><MudText>@_equipment.LocationName</MudText></MudItem>
            <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.caption">Zadužio</MudText><MudText>@(_equipment.CurrentAssigneeName ?? "Nije zaduženo")</MudText></MudItem>
            <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.caption">Vrijednost</MudText><MudText>@(_equipment.PurchaseValue is decimal v ? $"{v:0.00} {_equipment.Currency}" : "—")</MudText></MudItem>
            <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.caption">Datum nabave</MudText><MudText>@(_equipment.PurchaseDate?.ToString("dd.MM.yyyy.") ?? "—")</MudText></MudItem>
            <MudItem xs="12" sm="6" md="4"><MudText Typo="Typo.caption">Status arhive</MudText><MudText>@(_equipment.IsArchived ? "Arhivirano" : "Aktivno")</MudText></MudItem>
            <MudItem xs="12"><MudText Typo="Typo.caption">Napomene</MudText><MudText>@(_equipment.Notes ?? "—")</MudText></MudItem>
        </MudGrid>
    </MudPaper>

    <MudGrid>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.subtitle1" GutterBottom="true">Datoteke</MudText>
                @if (_filesLoading)
                {
                    <LoadingPanel Message="Učitavanje datoteka…" />
                }
                else if (_filesError is not null)
                {
                    <ErrorAlert Message="@_filesError" OnRetry="LoadFilesAsync" />
                }
                else
                {
                    var images = _files.Where(f => f.FileKind == FileKind.Image).ToList();
                    var documents = _files.Where(f => f.FileKind != FileKind.Image).ToList();

                    if (images.Count == 0 && documents.Count == 0)
                    {
                        <EmptyState Message="Još nema datoteka." />
                    }

                    if (images.Count > 0)
                    {
                        <MudGrid Spacing="1" Class="mb-2">
                            @foreach (var file in images)
                            {
                                <MudItem xs="6" sm="4">
                                    <MudPaper Class="pa-2" Outlined="true">
                                        <MudImage Src="@($"/files/{file.Id}")" Alt="@file.OriginalFileName" ObjectFit="ObjectFit.Cover" Height="100" Fluid="true" Class="rounded" />
                                        @if (file.IsCoverImage)
                                        {
                                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="mt-1">Naslovna</MudChip>
                                        }
                                        <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-1">
                                            @if (!file.IsCoverImage)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Star" Size="Size.Small" OnClick="@(() => SetCoverAsync(file))"
                                                               UserAttributes="@(new Dictionary<string, object> { ["aria-label"] = $"Postavi kao naslovnu {file.OriginalFileName}" })" />
                                            }
                                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteFileAsync(file))"
                                                           UserAttributes="@(new Dictionary<string, object> { ["aria-label"] = $"Izbriši {file.OriginalFileName}" })" />
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>
                            }
                        </MudGrid>
                    }

                    foreach (var doc in documents)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="py-1">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudChip T="string" Size="Size.Small">@KindLabel(doc.FileKind)</MudChip>
                                <a href="@($"/files/{doc.Id}")" target="_blank">@doc.OriginalFileName</a>
                            </MudStack>
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteFileAsync(doc))"
                                           UserAttributes="@(new Dictionary<string, object> { ["aria-label"] = $"Izbriši {doc.OriginalFileName}" })" />
                        </MudStack>
                    }

                    if (_uploadError is not null)
                    {
                        <ErrorAlert Message="@_uploadError" Class="mt-2" />
                    }

                    <MudSelect T="FileKind" Label="Vrsta datoteke" @bind-Value="_uploadKind" Class="mt-3" Dense="true">
                        <MudSelectItem T="FileKind" Value="FileKind.Image">Slika</MudSelectItem>
                        <MudSelectItem T="FileKind" Value="FileKind.Invoice">Račun</MudSelectItem>
                        <MudSelectItem T="FileKind" Value="FileKind.Warranty">Jamstveni list</MudSelectItem>
                        <MudSelectItem T="FileKind" Value="FileKind.ServiceDoc">Servisna dokumentacija</MudSelectItem>
                    </MudSelect>
                    <MudFileUpload T="IBrowserFile" OnFilesChanged="OnFileSelectedAsync" Accept="@AcceptFor(_uploadKind)" MaxFileSize="UploadLimits.MaxFileSizeBytes" Class="mt-2">
                        <CustomContent Context="fileUploadContext">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload"
                                       OnClick="@fileUploadContext.OpenFilePickerAsync" Disabled="_uploading">
                                Dodaj datoteku
                            </MudButton>
                        </CustomContent>
                    </MudFileUpload>
                    <MudText Typo="Typo.caption" Class="d-block mt-1">
                        Slike: PNG/JPG/WEBP, dokumenti: PDF, najviše @(UploadLimits.MaxFileSizeBytes / (1024 * 1024)) MB.
                    </MudText>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.subtitle1" GutterBottom="true">Povijest zaduženja</MudText>
                @if (_historyLoading)
                {
                    <LoadingPanel Message="Učitavanje povijesti…" />
                }
                else if (_historyError is not null)
                {
                    <ErrorAlert Message="@_historyError" OnRetry="LoadHistoryAsync" />
                }
                else if (_history.Count == 0)
                {
                    <EmptyState Message="Još nema zaduženja." />
                }
                else
                {
                    foreach (var entry in _history)
                    {
                        <MudStack Spacing="0" Class="py-1">
                            <MudText Typo="Typo.body2">
                                <b>@entry.EmployeeName</b> — @entry.StatusName
                            </MudText>
                            <MudText Typo="Typo.caption">
                                @entry.AssignedAtUtc.ToString("dd.MM.yyyy.")
                                @(entry.ReturnedAtUtc is DateTime returned ? $"– {returned:dd.MM.yyyy.}" : "")
                                · zadužio: @entry.AssignedByName
                                @(entry.ClosedByName is not null ? $"· zatvorio: {entry.ClosedByName}" : "")
                            </MudText>
                        </MudStack>
                    }
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.subtitle1" GutterBottom="true">Zahtjevi za otpis</MudText>
                @if (_equipment.WriteOffRequestCount > 0)
                {
                    <MudText>Ukupno zahtjeva: @_equipment.WriteOffRequestCount</MudText>
                }
                else
                {
                    <EmptyState Message="Još nema zahtjeva za otpis." />
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudButton Href="/equipment" Variant="Variant.Text" Class="mt-4">Natrag na popis</MudButton>
}

@code {
    [Parameter] public int Id { get; set; }

    private bool _loading = true;
    private string? _loadError;
    private EquipmentDetailDto? _equipment;

    private List<EquipmentFileDto> _files = new();
    private bool _filesLoading = true;
    private string? _filesError;
    private string? _uploadError;
    private bool _uploading;
    private FileKind _uploadKind = FileKind.Image;

    private List<AssignmentDto> _history = new();
    private bool _historyLoading = true;
    private string? _historyError;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadAsync(), LoadFilesAsync(), LoadHistoryAsync());
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        StateHasChanged();

        var result = await Api.GetAsync<EquipmentDetailDto>($"api/equipment/{Id}");
        _loading = false;

        if (result.IsSuccess)
        {
            _equipment = result.Value;
        }
        else
        {
            _loadError = result.Error!.Message;
        }
    }

    private async Task LoadFilesAsync()
    {
        _filesLoading = true;
        _filesError = null;
        StateHasChanged();

        var result = await Api.GetAsync<List<EquipmentFileDto>>($"api/equipment/{Id}/files");
        _filesLoading = false;

        if (result.IsSuccess)
        {
            _files = result.Value!;
        }
        else
        {
            _filesError = result.Error!.Message;
        }
        StateHasChanged();
    }

    private async Task LoadHistoryAsync()
    {
        _historyLoading = true;
        _historyError = null;
        StateHasChanged();

        var result = await Api.GetAsync<List<AssignmentDto>>($"api/assignments/history?equipmentId={Id}");
        _historyLoading = false;

        if (result.IsSuccess)
        {
            _history = result.Value!;
        }
        else
        {
            _historyError = result.Error!.Message;
        }
        StateHasChanged();
    }

    private static readonly DialogOptions AssignmentDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    private async Task OpenAssignDialogAsync()
    {
        var parameters = new DialogParameters<AssignDialog> { { x => x.EquipmentId, Id } };
        var dialogReference = await DialogService.ShowAsync<AssignDialog>("Zaduži opremu", parameters, AssignmentDialogOptions);
        var result = await dialogReference.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Oprema je zadužena.", Severity.Success);
            await Task.WhenAll(LoadAsync(), LoadHistoryAsync());
        }
    }

    private async Task OpenTransferDialogAsync()
    {
        var parameters = new DialogParameters<TransferDialog>
        {
            { x => x.EquipmentId, Id },
            { x => x.CurrentEmployeeName, _equipment!.CurrentAssigneeName },
        };
        var dialogReference = await DialogService.ShowAsync<TransferDialog>("Premjesti opremu", parameters, AssignmentDialogOptions);
        var result = await dialogReference.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Oprema je premještena.", Severity.Success);
            await Task.WhenAll(LoadAsync(), LoadHistoryAsync());
        }
    }

    private async Task OpenChangeLocationDialogAsync()
    {
        var parameters = new DialogParameters<ChangeLocationDialog>
        {
            { x => x.EquipmentId, Id },
            { x => x.CurrentLocationId, _equipment!.CurrentLocationId },
        };
        var dialogReference = await DialogService.ShowAsync<ChangeLocationDialog>("Promijeni lokaciju", parameters, AssignmentDialogOptions);
        var result = await dialogReference.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Lokacija je promijenjena.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task ReturnAsync()
    {
        var confirmed = await DialogService.ConfirmAsync(
            "Vratiti opremu?",
            $"Zaduženje opreme „{_equipment!.Name}” ({_equipment.InventoryNumber}) bit će zatvoreno.",
            "Vrati",
            Color.Primary);
        if (!confirmed)
        {
            return;
        }

        var assignmentId = _history.FirstOrDefault(a => a.AssignmentStatusId == 1)?.Id;
        if (assignmentId is null)
        {
            Snackbar.Add("Nije pronađeno aktivno zaduženje.", Severity.Error);
            return;
        }

        var result = await Api.PostAsync($"api/assignments/{assignmentId}/return");
        if (result.IsSuccess)
        {
            Snackbar.Add("Oprema je vraćena.", Severity.Success);
            await Task.WhenAll(LoadAsync(), LoadHistoryAsync());
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _uploadError = null;
        _uploading = true;
        StateHasChanged();

        try
        {
            using var content = new MultipartFormDataContent();
            await using var stream = e.File.OpenReadStream(maxAllowedSize: UploadLimits.MaxFileSizeBytes);
            using var streamContent = new StreamContent(stream);
            content.Add(streamContent, "File", e.File.Name);
            content.Add(new StringContent(_uploadKind.ToString()), "FileKind");

            var result = await Api.PostFileAsync<EquipmentFileDto>($"api/equipment/{Id}/files", content);
            if (result.IsSuccess)
            {
                Snackbar.Add("Datoteka je dodana.", Severity.Success);
                await LoadFilesAsync();
            }
            else
            {
                _uploadError = result.Error!.Message;
            }
        }
        catch (IOException)
        {
            _uploadError = $"Datoteka je prevelika (najviše {UploadLimits.MaxFileSizeBytes / (1024 * 1024)} MB).";
        }
        finally
        {
            _uploading = false;
            StateHasChanged();
        }
    }

    private async Task SetCoverAsync(EquipmentFileDto file)
    {
        var result = await Api.PostAsync($"api/equipment/{Id}/files/{file.Id}/set-cover");
        if (result.IsSuccess)
        {
            Snackbar.Add("Naslovna slika je postavljena.", Severity.Success);
            await LoadFilesAsync();
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
    }

    private async Task DeleteFileAsync(EquipmentFileDto file)
    {
        var confirmed = await DialogService.ConfirmAsync(
            "Izbrisati datoteku?",
            $"Datoteka „{file.OriginalFileName}” bit će trajno izbrisana.",
            "Izbriši",
            Color.Error);
        if (!confirmed)
        {
            return;
        }

        var result = await Api.DeleteAsync($"api/files/{file.Id}");
        if (result.IsSuccess)
        {
            Snackbar.Add("Datoteka je izbrisana.", Severity.Success);
            await LoadFilesAsync();
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
    }

    private static string AcceptFor(FileKind kind) => kind == FileKind.Image
        ? string.Join(",", UploadLimits.AllowedImageExtensions.Keys)
        : string.Join(",", UploadLimits.AllowedDocumentExtensions.Keys);

    private static string KindLabel(FileKind kind) => kind switch
    {
        FileKind.Image => "Slika",
        FileKind.Invoice => "Račun",
        FileKind.Warranty => "Jamstveni list",
        FileKind.ServiceDoc => "Servisna dokumentacija",
        _ => kind.ToString(),
    };

    private async Task ArchiveAsync()
    {
        var confirmed = await DialogService.ConfirmAsync(
            "Arhivirati opremu?",
            $"Oprema „{_equipment!.Name}” ({_equipment.InventoryNumber}) bit će arhivirana.",
            "Arhiviraj",
            Color.Error);
        if (!confirmed)
        {
            return;
        }

        var result = await Api.DeleteAsync($"api/equipment/{Id}");
        if (result.IsSuccess)
        {
            Snackbar.Add("Oprema je arhivirana.", Severity.Success);
            Navigation.NavigateTo("/equipment");
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
    }
}

@page "/"
@inject ApiClient Api

<PageTitle>Početna — e-Imovina</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">e-Imovina Županije</MudText>
<MudText Class="mb-6" Typo="Typo.body1">
    Sustav za evidenciju i upravljanje županijskom opremom.
</MudText>

<MudPaper Class="pa-4" MaxWidth="480px" Elevation="1">
    <MudText Typo="Typo.subtitle1" GutterBottom="true">Status povezivanja s API-jem</MudText>

    @if (_state == PingState.Loading)
    {
        <LoadingPanel Message="Povezivanje s API-jem…" />
    }
    else if (_state == PingState.Ok)
    {
        <MudAlert Severity="Severity.Success" Dense="true">API odgovara: @_status</MudAlert>
    }
    else
    {
        <ErrorAlert Message="@($"Greška pri povezivanju s API-jem: {_error}")" OnRetry="LoadAsync" />
    }
</MudPaper>

@code {
    private enum PingState { Loading, Ok, Error }

    private PingState _state = PingState.Loading;
    private string? _status;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _state = PingState.Loading;
        var result = await Api.GetAsync<PingResponse>("api/ping");
        if (result.IsSuccess)
        {
            _status = result.Value?.Status ?? "(prazan odgovor)";
            _state = PingState.Ok;
        }
        else
        {
            _error = result.Error!.Message;
            _state = PingState.Error;
        }
    }

    private sealed record PingResponse(string Status);
}

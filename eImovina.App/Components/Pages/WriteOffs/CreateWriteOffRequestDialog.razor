@using System.ComponentModel.DataAnnotations
@using eImovina.Shared.Equipment
@using eImovina.Shared.WriteOffRequests
@using eImovina.Shared.Common
@inject ApiClient Api

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="@_model">
            <MudStack Spacing="3">
                @if (EquipmentId is null)
                {
                    <MudSelect T="int" Label="Oprema" @bind-Value="_model.EquipmentId" For="@(() => _model.EquipmentId)" Variant="Variant.Outlined">
                        @foreach (var item in _equipmentOptions)
                        {
                            <MudSelectItem T="int" Value="@item.Id">@($"{item.InventoryNumber} — {item.Name}")</MudSelectItem>
                        }
                    </MudSelect>
                }
                <MudTextField T="string" Label="Razlog" @bind-Value="_model.Reason" For="@(() => _model.Reason)"
                              Immediate="true" Variant="Variant.Outlined" Lines="3"
                              HelperText="Npr. oštećena, izgubljena, neupotrebljiva ili zastarjela oprema." />
            </MudStack>
        </MudForm>
        @if (_errorMessage is not null)
        {
            <ErrorAlert Message="@_errorMessage" Class="mt-3" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Odustani</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="@(_saving || _loading)">Pošalji zahtjev</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public int? EquipmentId { get; set; }

    private MudForm _form = null!;
    private readonly CreateWriteOffFormModel _model = new();
    private List<EquipmentListItemDto> _equipmentOptions = new();
    private bool _loading = true;
    private string? _errorMessage;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        if (EquipmentId is int id)
        {
            _model.EquipmentId = id;
        }
        else
        {
            // ExcludeStatusId=5 (Otpisano) - already-written-off equipment can't be selected for a
            // new write-off (the API would reject it with a 409 anyway; this keeps it off the list).
            var result = await Api.GetAsync<PagedResult<EquipmentListItemDto>>("api/equipment?PageSize=100&IsArchived=false&ExcludeStatusId=5");
            if (result.IsSuccess)
            {
                _equipmentOptions = result.Value!.Items.ToList();
            }
        }

        _loading = false;
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _saving = true;
        _errorMessage = null;

        var result = await Api.PostAsync<CreateWriteOffRequestDto, WriteOffRequestDetailDto>(
            "api/writeoffrequests",
            new CreateWriteOffRequestDto(_model.EquipmentId, _model.Reason!));

        _saving = false;

        if (result.IsSuccess)
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            _errorMessage = result.Error!.Message;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private sealed class CreateWriteOffFormModel
    {
        [Range(1, int.MaxValue, ErrorMessage = "Potrebno je odabrati opremu.")]
        public int EquipmentId { get; set; }

        [Required(ErrorMessage = "Razlog je obavezan.")]
        [MaxLength(1000)]
        public string? Reason { get; set; }
    }
}
